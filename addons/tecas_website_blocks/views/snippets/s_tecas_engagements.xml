<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    "Nos engagements" — orange centred heading, lead, then three icon columns.

    The icons are inline SVG rather than an icon font or image files: they take
    their two colours from the same CSS variables as the rest of the block, so
    a colour change stays a one-line edit and there are no binary assets to
    ship or lose.
-->
<template id="s_tecas_engagements" name="Nos engagements">
    <section class="s_tecas_engagements pt64 pb64">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="s_tecas_eng_title">Nos engagements envers vous</h2>
                    <p class="s_tecas_eng_lead">Des solutions fiables pour répondre à vos attentes.</p>
                </div>
            </div>
            <div class="row pt32">

                <div class="col-md-4 text-center pt24 pb24">
                    <div class="s_tecas_eng_icon">
                        <svg viewBox="0 0 96 96" role="img" aria-label="Livraison">
                            <g fill="none" class="s_tecas_ink" stroke-width="3"
                               stroke-linejoin="round" stroke-linecap="round">
                                <path d="M12 32 L48 18 L84 32 L48 46 Z"/>
                                <path d="M12 32 V66 L48 80 V46"/>
                                <path d="M84 32 V66 L48 80"/>
                            </g>
                            <g fill="none" class="s_tecas_accent" stroke-width="4"
                               stroke-linejoin="round" stroke-linecap="round">
                                <path d="M31 72 V58 M26 63 L31 58 L36 63"/>
                                <path d="M45 77 V63 M40 68 L45 63 L50 68"/>
                            </g>
                        </svg>
                    </div>
                    <h3 class="s_tecas_eng_label">Livraison partout au Maroc</h3>
                </div>

                <div class="col-md-4 text-center pt24 pb24">
                    <div class="s_tecas_eng_icon">
                        <svg viewBox="0 0 96 96" role="img" aria-label="Garantie">
                            <path d="M48 12 L78 24 V49 C78 66 65 76 48 84 C31 76 18 66 18 49 V24 Z"
                                  fill="none" class="s_tecas_ink" stroke-width="3"
                                  stroke-linejoin="round"/>
                            <path d="M34 48 L44 59 L64 37" fill="none" class="s_tecas_accent"
                                  stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h3 class="s_tecas_eng_label">Garantie &amp; service après-vente</h3>
                </div>

                <div class="col-md-4 text-center pt24 pb24">
                    <div class="s_tecas_eng_icon">
                        <svg viewBox="0 0 96 96" role="img" aria-label="Maintenance">
                            <g class="s_tecas_ink" fill="none" stroke-width="3">
                                <circle cx="46" cy="46" r="24"/>
                                <circle cx="46" cy="46" r="10"/>
                                <g stroke-width="5" stroke-linecap="round">
                                    <path d="M46 16 V24"/>
                                    <path d="M46 68 V76"/>
                                    <path d="M16 46 H24"/>
                                    <path d="M68 46 H76"/>
                                    <path d="M25 25 L31 31"/>
                                    <path d="M61 61 L67 67"/>
                                    <path d="M67 25 L61 31"/>
                                    <path d="M31 61 L25 67"/>
                                </g>
                            </g>
                            <path d="M62 62 L82 82" class="s_tecas_accent" fill="none"
                                  stroke-width="7" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h3 class="s_tecas_eng_label">Suivi et maintenance</h3>
                </div>

            </div>
        </div>
    </section>
</template>

</odoo>
