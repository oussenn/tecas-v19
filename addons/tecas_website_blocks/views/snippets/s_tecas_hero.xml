<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Hero: full-width photo background, translucent white card holding the
    headline / lead / CTA, and an orange rule closing the section.

    The background is a normal Odoo background image (oe_img_bg + inline
    background-image), so the client can swap the photo from the editor
    without touching code.

    The panel cut-out is a plain <img>, a direct child of the section rather
    than of .container: it is absolutely positioned against the SECTION so it
    can hang past the orange rule into the block below. Anchoring it to the
    container instead would tie its bottom edge to the height of the text card,
    which floats mid-section, and the overhang would never reach the rule.
    Being an ordinary img it stays double-clickable in the editor, so the photo
    can be swapped without touching code.
-->
<template id="s_tecas_hero" name="Hero TECAS">
    <section class="s_tecas_hero oe_img_bg o_bg_img_center"
             style="background-image: url('/web/image/8068'); background-size: cover;">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="s_tecas_hero_card">
                        <h1 class="s_tecas_hero_title">
                            Installation et vente de matériel solaire au Maroc :
                            panneaux solaires, onduleurs et batteries
                        </h1>
                        <p class="s_tecas_hero_lead">
                            Découvrez nos panneaux solaires, onduleurs et batteries adaptés
                            à vos besoins. Contactez-nous pour une évaluation gratuite et un
                            accompagnement personnalisé.<br/>
                            Livraison de matériel solaire partout au Maroc.
                        </p>
                        <p class="mb-0">
                            <!-- /contactus exists but is unpublished (404s for
                                 visitors); /demande-devis is the site's live
                                 quote-request page. -->
                            <a href="/demande-devis" class="btn s_tecas_btn_orange btn-lg">
                                Demander une évaluation gratuite
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <img class="s_tecas_hero_panel" src="/web/image/27506"
             alt="Panneaux solaires monocristallin et polycristallin"/>
        <div class="s_tecas_hero_rule"/>
    </section>
</template>

</odoo>
