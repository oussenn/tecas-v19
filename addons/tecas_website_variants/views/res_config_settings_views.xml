<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tecas.variants</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='product_attributes_setting']" position="after">
                <setting
                    string="Split variants in the shop"
                    id="tecas_shop_split_variants_setting"
                    help="Show one tile per variant on the shop page instead of one tile per
                          product. Variants with nothing left to sell stay listed but are dimmed
                          and flagged as out of stock."
                >
                    <field name="shop_split_variants"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
