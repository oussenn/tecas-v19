<odoo>

  <!--
    Everything below renders the *resolved* extras: the variant's own value when
    it has one, the product's otherwise. `product_variant` is always supplied by
    the product page controller and is the combination currently selected.
    The ids are the handles the frontend JS uses to swap content when the
    visitor picks another variant.
  -->

  <template id="product_webextras_title" inherit_id="website_sale.product_title">
    <xpath expr="//h1[@t-field='product.name']" position="attributes">
      <attribute name="t-field"/>
      <attribute name="t-out">product_variant.webx_name or product.name</attribute>
      <attribute name="id">o_tecas_webx_name</attribute>
    </xpath>
  </template>

  <template id="product_webextras_block" inherit_id="website_sale.product">
    <!-- Insert custom info right after the long product description -->
    <xpath expr="//div[@id='product_full_description']" position="after">

      <!-- Web description -->
      <section
        id="o_tecas_webx_description"
        t-attf-class="mt-4 #{'' if product_variant.webx_description else 'd-none'}"
      >
        <div class="container px-3">
          <h3 class="h5">Description technique</h3>
          <div class="o_tecas_webx_description_body">
            <t t-out="product_variant.webx_description"/>
          </div>
        </div>
      </section>

      <!-- Tech sheet PDF (centered button) -->
      <section
        id="o_tecas_webx_techsheet"
        t-attf-class="mt-3 #{'' if product_variant.webx_tech_sheet_url else 'd-none'}"
      >
        <div class="container">
          <div class="text-center">
            <a
              class="btn btn-outline-primary o_tecas_webx_techsheet_link"
              t-att-href="product_variant.webx_tech_sheet_url"
            >
              Télécharger la fiche technique (PDF)
            </a>
          </div>
        </div>
      </section>

      <!-- Image gallery -->
      <section
        id="o_tecas_webx_gallery"
        t-attf-class="mt-4 #{'' if product_variant._webx_gallery() else 'd-none'}"
      >
        <div class="container">
          <h3 class="h5">Galerie</h3>
          <div class="row o_tecas_webx_gallery_body">
            <t t-foreach="product_variant._webx_gallery()" t-as="img">
              <div class="col-4 col-md-3 mb-3">
                <a t-att-href="'/web/content/%s?download=0' % img.id" target="_blank" rel="noopener">
                  <img t-att-src="'/web/image/%s' % img.id" class="img-fluid rounded shadow-sm"/>
                </a>
              </div>
            </t>
          </div>
        </div>
      </section>

    </xpath>
  </template>

</odoo>
